{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Occupational Health Source",
  "type": "object",
  "required": [
    "id",
    "org",
    "title",
    "url",
    "role",
    "jurisdiction",
    "verified_on"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "org": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "role": {
      "type": "string"
    },
    "jurisdiction": {
      "type": "string"
    },
    "verified_on": {
      "type": "string"
    },
    "verification_status": {
      "type": "string"
    }
  }
}