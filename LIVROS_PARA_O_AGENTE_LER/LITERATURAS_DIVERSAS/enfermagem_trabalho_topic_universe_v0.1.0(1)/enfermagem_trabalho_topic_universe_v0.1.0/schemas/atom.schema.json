{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Occupational Health Atomic Knowledge",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "required": [
      "type",
      "statement",
      "sources"
    ],
    "properties": {
      "type": {
        "type": "string"
      },
      "statement": {
        "type": "string",
        "minLength": 10
      },
      "sources": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1
      }
    }
  }
}