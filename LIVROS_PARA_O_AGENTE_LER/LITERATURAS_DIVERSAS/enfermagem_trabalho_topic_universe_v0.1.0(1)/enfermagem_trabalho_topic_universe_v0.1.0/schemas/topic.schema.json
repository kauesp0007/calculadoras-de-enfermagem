{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Occupational Health Topic",
  "type": "object",
  "required": [
    "id",
    "domain_code",
    "module_id",
    "title",
    "slug",
    "audiences",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "domain_code": {
      "type": "string"
    },
    "module_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "audiences": {
      "type": "array",
      "items": {
        "enum": [
          "T",
          "G",
          "P"
        ]
      }
    },
    "status": {
      "type": "string"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}