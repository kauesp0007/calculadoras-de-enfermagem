{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "biblioteca_de_enfermagem_json/schemas/evidencia.schema.json",
  "title": "Evidência Científica",
  "description": "Dados metodológicos e quantitativos extraídos da fonte (spec §9, §32). Nunca recalcular sem registrar a transformação.",
  "type": "object",
  "properties": {
    "metodologia": { "type": ["string", "null"] },
    "desenho_estudo": {
      "$ref": "taxonomia.schema.json#/definitions/desenhoEstudo"
    },
    "nivel_evidencia": {
      "$ref": "taxonomia.schema.json#/definitions/nivelEvidencia"
    },
    "tamanho_amostra": { "type": ["string", "null"] },
    "populacao_estudada": { "type": ["string", "null"] },
    "faixa_etaria": { "type": ["string", "null"] },
    "cenario_clinico": { "type": ["string", "null"] },
    "pais_estudo": { "type": ["string", "null"] },
    "resultados": { "type": ["string", "null"] },
    "estatisticas": {
      "type": "array",
      "description": "Dados quantitativos (prevalência, incidência, RR, OR, IC, p-valor, média, mediana, DP etc.).",
      "items": {
        "type": "object",
        "properties": {
          "tipo": { "type": ["string", "null"] },
          "valor": { "type": ["string", "null"] },
          "unidade": { "type": ["string", "null"] },
          "fonte_trecho": { "type": ["string", "null"], "description": "Trecho/evidência de onde o dado foi extraído (rastreabilidade §11)." },
          "transformacao": { "type": ["string", "null"], "description": "Registra se houve transformação matemática sobre o valor original." }
        },
        "additionalProperties": true
      }
    },
    "limitacoes": { "type": ["string", "null"] },
    "conclusoes": { "type": ["string", "null"] },
    "recomendacoes": { "type": ["string", "null"] }
  },
  "additionalProperties": true
}
