{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "biblioteca_de_enfermagem_json/schemas/referencia.schema.json",
  "title": "Referência Bibliográfica (Vancouver)",
  "description": "Referência bibliográfica no estilo Vancouver. Campos ausentes na fonte devem ser null ou 'não identificado na fonte' — nunca inventados (spec §12, §30).",
  "type": "object",
  "required": ["autores"],
  "properties": {
    "autores": {
      "type": "array",
      "description": "Lista de autores. Cada autor: sobrenome + iniciais (sem ponto), conforme Vancouver.",
      "items": {
        "type": "object",
        "properties": {
          "sobrenome": { "type": ["string", "null"] },
          "iniciais": { "type": ["string", "null"] },
          "nome_completo": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    },
    "titulo": { "type": ["string", "null"] },
    "subtitulo": { "type": ["string", "null"] },
    "tipo_documental": {
      "$ref": "taxonomia.schema.json#/definitions/tipoDocumental"
    },
    "edicao": { "type": ["string", "null"] },
    "local": { "type": ["string", "null"] },
    "editora": { "type": ["string", "null"] },
    "periodico": { "type": ["string", "null"] },
    "ano": { "type": ["integer", "null"] },
    "volume": { "type": ["string", "null"] },
    "numero": { "type": ["string", "null"] },
    "paginas": { "type": ["string", "null"] },
    "doi": { "type": ["string", "null"] },
    "isbn": { "type": ["string", "null"] },
    "issn": { "type": ["string", "null"] },
    "url": { "type": ["string", "null"] },
    "url_fonte_original": { "type": ["string", "null"] },
    "data_acesso": { "type": ["string", "null"], "description": "Data de acesso à URL (Vancouver exige quando citado de fonte eletrônica)." },
    "texto_formatado": {
      "type": ["string", "null"],
      "description": "Referência já formatada em Vancouver (ex.: Sobrenome AB, Sobrenome CD. Título. 3. ed. Local: Editora; 2024.)."
    },
    "observacao": { "type": ["string", "null"] }
  },
  "additionalProperties": true
}
