{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "biblioteca_de_enfermagem_json/schemas/conflito.schema.json",
  "title": "Registro de Conflito entre Fontes",
  "description": "Quando duas ou mais fontes divergem, registrar o conflito sem escolher arbitrariamente (spec §17). Se não resolver: CONFLITO DE EVIDÊNCIAS — REQUER AVALIAÇÃO HUMANA.",
  "type": "object",
  "required": ["id", "assunto", "fontes"],
  "properties": {
    "id": { "type": "string" },
    "assunto": { "type": "string" },
    "fontes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "fonte_id": { "type": ["string", "null"] },
          "documento": { "type": ["string", "null"] },
          "autor": { "type": ["string", "null"] },
          "ano": { "type": ["integer", "null"] },
          "afirmacao": { "type": ["string", "null"] },
          "data": { "type": ["string", "null"] },
          "qualidade_metodologica": { "type": ["string", "null"] },
          "contexto": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    },
    "possiveis_razoes_divergencia": { "type": ["string", "null"] },
    "evidencia_mais_recente": { "type": ["string", "null"] },
    "conclusao_agente": { "type": ["string", "null"] },
    "grau_certeza": { "type": ["string", "null"] },
    "requer_revisao_humana": { "type": "boolean", "default": false },
    "status_resolucao": {
      "type": "string",
      "enum": ["ABERTO", "RESOLVIDO", "REQUER_AVALIACAO_HUMANA"],
      "default": "ABERTO"
    }
  },
  "additionalProperties": true
}
