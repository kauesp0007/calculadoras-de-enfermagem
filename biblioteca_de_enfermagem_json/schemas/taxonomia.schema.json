{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "biblioteca_de_enfermagem_json/schemas/taxonomia.schema.json",
  "title": "Taxonomia do Sistema de Conhecimento",
  "description": "Vocabulários controlados: tipos documentais (spec §7), especialidades (§35), profissões (§34), desenho de estudo e nível de evidência (§16).",
  "definitions": {
    "tipoDocumental": {
      "type": "string",
      "enum": [
        "BOOK",
        "ARTICLE",
        "JOURNAL",
        "GUIDELINE",
        "PROTOCOL",
        "POP",
        "MANUAL",
        "DICTIONARY",
        "THESIS",
        "DISSERTATION",
        "MONOGRAPH",
        "GOVERNMENT_DOCUMENT",
        "TECHNICAL_REPORT",
        "INTERVIEW",
        "VIDEO_TRANSCRIPT",
        "EDUCATIONAL_MATERIAL",
        "OTHER"
      ]
    },
    "especialidade": {
      "type": "string",
      "enum": [
        "enfermagem_medico_cirurgica",
        "terapia_intensiva",
        "emergencia",
        "pediatria",
        "neonatologia",
        "obstetricia",
        "saude_da_mulher",
        "saude_mental",
        "geriatria_gerontologia",
        "saude_coletiva",
        "oncologia",
        "cardiologia",
        "nefrologia",
        "neurologia",
        "infectologia",
        "centro_cirurgico",
        "cme",
        "seguranca_do_paciente",
        "gestao",
        "educacao_em_saude",
        "outras"
      ]
    },
    "profissao": {
      "type": "string",
      "enum": [
        "enfermagem",
        "medicina",
        "fisioterapia",
        "farmacia",
        "nutricao",
        "odontologia",
        "psicologia",
        "terapia_ocupacional",
        "fonoaudiologia",
        "saude_publica",
        "outras"
      ]
    },
    "desenhoEstudo": {
      "type": ["string", "null"],
      "enum": [
        "revisao_sistematica",
        "meta_analise",
        "ensaio_clinico_randomizado",
        "estudo_observacional",
        "coorte",
        "caso_controle",
        "transversal",
        "serie_de_casos",
        "relato_de_caso",
        "revisao_integrativa",
        "revisao_narrativa",
        "diretriz",
        "legislacao_norma",
        "consenso_profissional",
        "livro_academico",
        "manual_tecnico",
        "material_educacional",
        "nao_se_aplica",
        "não identificado na fonte",
        null
      ]
    },
    "nivelEvidencia": {
      "type": ["string", "null"],
      "enum": [
        "legislacao_norma",
        "orgao_governamental",
        "conselho_profissional",
        "sociedade_cientifica",
        "diretriz_oficial",
        "revisao_sistematica_meta_analise",
        "ensaio_clinico",
        "estudo_observacional",
        "livro_academico",
        "manual_tecnico",
        "material_educacional",
        "não identificado na fonte",
        null
      ],
      "description": "Hierarquia de confiabilidade da fonte (spec §16). Não aplicada cegamente: considerar também qualidade, atualidade, metodologia, autoridade, contexto e aplicabilidade."
    }
  },
  "additionalProperties": true
}
