{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.calculadorasdeenfermagem.com.br/schemas/ipe.schema.json",
  "title": "IPE — Information Produced by the Entity",
  "version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ipe_id",
    "canonical_id",
    "purpose",
    "period",
    "completeness",
    "accuracy",
    "conclusion"
  ],
  "properties": {
    "ipe_id": {
      "type": "string"
    },
    "canonical_id": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      }
    },
    "completeness": {
      "$ref": "#/$defs/assertion"
    },
    "accuracy": {
      "$ref": "#/$defs/assertion"
    },
    "conclusion": {
      "type": "string",
      "enum": [
        "SUFFICIENT",
        "INSUFFICIENT",
        "NOT_EVALUATED"
      ]
    },
    "evaluated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "$defs": {
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "basis"
      ],
      "properties": {
        "result": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "NOT_EVALUATED"
          ]
        },
        "basis": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
