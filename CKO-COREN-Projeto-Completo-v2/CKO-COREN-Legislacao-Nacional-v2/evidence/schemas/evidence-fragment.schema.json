{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.calculadorasdeenfermagem.com.br/schemas/evidence-fragment.schema.json",
  "title": "Evidence Fragment — trecho localizado dentro do snapshot",
  "version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fragment_id",
    "evidence_source_id",
    "locator",
    "extracted_text",
    "source_sha256",
    "temporal_state"
  ],
  "properties": {
    "fragment_id": {
      "type": "string"
    },
    "evidence_source_id": {
      "type": "string"
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "ARTIGO",
            "PARAGRAFO",
            "INCISO",
            "ITEM",
            "PAGINA",
            "SELETOR_DOM"
          ]
        },
        "value": {
          "type": "string"
        },
        "page": {
          "type": [
            "integer",
            "null"
          ]
        },
        "char_start": {
          "type": [
            "integer",
            "null"
          ]
        },
        "char_end": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "extracted_text": {
      "type": "string",
      "minLength": 1
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fragment_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "temporal_state": {
      "type": "string",
      "enum": [
        "AT_PUBLICATION",
        "CURRENT_PER_SOURCE",
        "HISTORICAL"
      ]
    },
    "extraction_method": {
      "type": "string"
    },
    "extracted_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
