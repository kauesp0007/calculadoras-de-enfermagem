{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.calculadorasdeenfermagem.com.br/schemas/caat-execution.schema.json",
  "title": "CAAT Execution — teste automatizado reperformavel",
  "version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "caat_id",
    "scope",
    "procedure",
    "executed_at",
    "population",
    "exceptions",
    "result"
  ],
  "properties": {
    "caat_id": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "procedure": {
      "type": "string"
    },
    "engine_version": {
      "type": "string"
    },
    "executed_at": {
      "type": "string",
      "format": "date-time"
    },
    "population": {
      "type": "integer",
      "minimum": 0
    },
    "tested": {
      "type": "integer",
      "minimum": 0
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "finding"
        ],
        "properties": {
          "ref": {
            "type": "string"
          },
          "finding": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          }
        }
      }
    },
    "result": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "NOT_EXECUTED"
      ]
    },
    "reperformance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deterministic": {
          "type": "boolean"
        },
        "input_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "output_hash": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
