{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.calculadorasdeenfermagem.com.br/schemas/alcoa-assessment.schema.json",
  "title": "ALCOA++ Assessment",
  "version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assessment_id",
    "subject_ref",
    "attributes",
    "conclusion"
  ],
  "properties": {
    "assessment_id": {
      "type": "string"
    },
    "subject_ref": {
      "type": "string"
    },
    "assessed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attributable",
        "legible",
        "contemporaneous",
        "original",
        "accurate",
        "complete",
        "consistent",
        "enduring",
        "available",
        "traceable"
      ],
      "properties": {
        "attributable": {
          "$ref": "#/$defs/attr"
        },
        "legible": {
          "$ref": "#/$defs/attr"
        },
        "contemporaneous": {
          "$ref": "#/$defs/attr"
        },
        "original": {
          "$ref": "#/$defs/attr"
        },
        "accurate": {
          "$ref": "#/$defs/attr"
        },
        "complete": {
          "$ref": "#/$defs/attr"
        },
        "consistent": {
          "$ref": "#/$defs/attr"
        },
        "enduring": {
          "$ref": "#/$defs/attr"
        },
        "available": {
          "$ref": "#/$defs/attr"
        },
        "traceable": {
          "$ref": "#/$defs/attr"
        }
      }
    },
    "conclusion": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "NOT_EVALUATED"
      ]
    }
  },
  "$defs": {
    "attr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "basis"
      ],
      "properties": {
        "result": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "NOT_EVALUATED"
          ]
        },
        "basis": {
          "type": "string"
        }
      }
    }
  }
}
