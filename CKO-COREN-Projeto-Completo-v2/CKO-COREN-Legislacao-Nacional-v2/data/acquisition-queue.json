  "version": "2.0.0",
  "executor": "monitoring/regulatory-monitor.mjs@1.0.0",
  "cycle": {
    "name": "Ciclo circular de conformidade regulatória",
    "steps": [
      {
        "step": "MONITOR",
        "action": "Reler a URL oficial e calcular SHA-256 do snapshot."
      },
      {
        "step": "DETECT",
        "action": "Comparar com o hash do último snapshot conhecido."
      },
      {
        "step": "CHANGESET",
        "action": "Registrar changeset no version_envelope do canônico afetado."
      },
      {
        "step": "INVALIDATE",
        "action": "Marcar como obsoletos todos os artefatos do lineage do canônico."
      },
      {
        "step": "REVALIDATE",
        "action": "Reexecutar SCHEMA, EVIDENCE, TEMPORAL, RELATIONS, IPE, ALCOA, PROJECTION."
      },
      {
        "step": "RERENDER",
        "action": "Regerar apenas as projeções elegíveis e recalcular o output hash."
      },
      {
        "step": "REGATE",
        "action": "Reexecutar assurance-engine e release-gate."
      },
      {
        "step": "MONITOR",
        "action": "Reagendar a verificação da fonte."
      }
    ],
    "idempotency": "Chave = (evidence_source_id, sha256). Snapshot idêntico não gera changeset nem rerender.",
    "retry": {
      "max_attempts": 3,
      "backoff": "exponencial 1min/5min/25min",
      "on_permanent_failure": "acquisition_status=ACQUISITION_FAILED e gate EVIDENCE permanece FAIL"
    },
    "cadence_suggested": {
      "transparencia_portal": "semanal",
      "pagina_regional": "semanal",
      "sistema_federal": "mensal"
    }
  },
  "current_state": {
    "snapshots_acquired": 0,
    "snapshots_pending": 3,
    "blocking": "Aquisição não executada neste ambiente; nenhum hash foi fabricado.",
    "command": "node monitoring/regulatory-monitor.mjs --acquire --root=."
  }
}
