{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.calculadorasdeenfermagem.com.br/schemas/projection-lineage.schema.json",
  "title": "Projection Lineage — cadeia source -> evidence -> projection -> output",
  "version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lineage_id",
    "canonical_id",
    "projection_id",
    "surface",
    "versions",
    "inputs",
    "output",
    "generated_at"
  ],
  "properties": {
    "lineage_id": {
      "type": "string"
    },
    "canonical_id": {
      "type": "string"
    },
    "projection_id": {
      "type": "string"
    },
    "surface": {
      "type": "string",
      "enum": [
        "legislation",
        "pages",
        "resources",
        "social",
        "pdf",
        "schema"
      ]
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "content",
        "engine",
        "validator",
        "renderer",
        "template"
      ],
      "properties": {
        "schema": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "engine": {
          "type": "string"
        },
        "validator": {
          "type": "string"
        },
        "renderer": {
          "type": "string"
        },
        "template": {
          "type": "string"
        },
        "media_model": {
          "type": "string"
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_sha256"
      ],
      "properties": {
        "canonical_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "evidence_source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_fragment_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dto_sha256": {
          "type": "string"
        },
        "intermediate_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Hash do artefato intermediário consumido pelo executor (HTML de impressão, media-spec)."
        },
        "intermediate_path": {
          "type": "string"
        },
        "deterministic": {
          "type": "boolean"
        },
        "generative_model_used": {
          "type": "boolean",
          "description": "Sempre false: a composição de mídia é vetorial e determinística."
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "byte_length"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "byte_length": {
          "type": "integer"
        },
        "mime_type": {
          "type": "string"
        }
      }
    },
    "assurance_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
