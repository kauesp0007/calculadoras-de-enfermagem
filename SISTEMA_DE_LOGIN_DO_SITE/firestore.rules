rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && (!('role' in request.resource.data) || request.resource.data.role == 'user')
        && (!('plan' in request.resource.data) || request.resource.data.plan == 'free')
        && (!('status' in request.resource.data) || request.resource.data.status == 'active');

      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['uid', 'role', 'plan', 'status', 'createdAt', 'permissions']);

      allow delete: if isOwner(uid);
    }

    match /users/{uid}/favorites/{favId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && request.resource.data.pageId == favId;
      allow update: if isOwner(uid) && request.resource.data.pageId == resource.data.pageId;
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/history/{historyId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if isOwner(uid);
    }

    match /plans/{planId} {
      allow read: if true;
      allow write: if false;
    }

    match /benefits/{benefitId} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{uid}/licenses/{licenseId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Histórico de assinatura: o cliente somente lê o próprio histórico.
    // Ativação, renovação e cancelamento são exclusivos do backend de pagamentos.
    match /users/{uid}/subscriptions/{subscriptionId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Dados operacionais de checkout, clientes, eventos e assinantes são
    // privados e escritos exclusivamente por Edge Functions com credencial de servidor.
    match /premiumOrders/{orderId} {
      allow read, write: if false;
    }
    match /asaasCustomers/{customerId} {
      allow read, write: if false;
    }
    match /asaasSubscribers/{subscriberId} {
      allow read, write: if false;
    }
    match /asaasEvents/{eventId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
