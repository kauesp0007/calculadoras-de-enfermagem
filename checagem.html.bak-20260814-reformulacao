if(a === 'favorite'){
e.preventDefault();
try{
var k = 'cko:favorites';
var l = JSON.parse(localStorage.getItem(k) || '[]');
var id = location.pathname;
if(!l.includes(id)) l.push(id);
localStorage.setItem(k, JSON.stringify(l));
alert('Página adicionada aos favoritos!');
}catch(ex){ alert('Pressione Ctrl+D para favoritar no navegador.'); }
return;
}
if(a === 'share'){ e.preventDefault(); openShare(); return; }
if(a === 'print'){ e.preventDefault(); window.print(); return; }
if(a === 'report'){ e.preventDefault(); location.href = 'fale.html'; return; }
});
});

document.querySelectorAll('.ce-share-btn[data-share]').forEach(function(btn){
btn.addEventListener('click', function(e){
var s = this.getAttribute('data-share');
var url = encodeURIComponent(location.href);
