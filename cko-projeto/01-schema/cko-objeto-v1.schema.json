{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clinical.devices/schemas/cko-objeto-v1.schema.json",
  "title": "CKO Object (core+domainPayload) v1",
  "type": "object",
  "required": [
    "id",
    "knowledgeType",
    "library",
    "identity",
    "core"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "knowledgeType": {
      "type": "string"
    },
    "library": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "identity": {
      "type": "object",
      "required": [
        "name",
        "slug"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "tags": {
          "type": "array"
        },
        "language": {
          "type": "string"
        }
      }
    },
    "core": {
      "type": "object",
      "properties": {
        "knowledgeGraph": {
          "type": "object"
        },
        "governance": {
          "type": "object"
        },
        "evidence": {
          "type": "object"
        },
        "runtime": {
          "type": "object"
        }
      }
    },
    "domainPayload": {
      "type": "object"
    }
  }
}