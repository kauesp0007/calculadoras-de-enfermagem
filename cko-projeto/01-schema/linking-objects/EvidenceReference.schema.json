{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "EvidenceReference",
  "description": "Referência de evidência estruturada (nível, grau, fonte).",
  "required": [
    "id",
    "title"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "Guideline",
        "RCT",
        "SystematicReview",
        "MetaAnalysis",
        "Consensus",
        "Standard"
      ]
    },
    "authority": {
      "type": "string"
    },
    "year": {
      "type": "integer"
    },
    "level": {
      "type": "string"
    },
    "recommendationGrade": {
      "type": "string",
      "enum": [
        "Strong",
        "Conditional",
        "Weak",
        ""
      ]
    },
    "doi": {
      "type": "string"
    },
    "url": {
      "type": "string",
      "format": "uri"
    }
  },
  "$id": "https://clinical.devices/schemas/linking/EvidenceReference.schema.json"
}