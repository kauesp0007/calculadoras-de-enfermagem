{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "ClinicalPathway",
  "description": "Via clínica: estágios ordenados com transições e desfechos.",
  "required": [
    "id",
    "stages"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "condition": {
      "type": "string"
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "next": {
            "type": "string"
          }
        }
      }
    },
    "expectedOutcomes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$id": "https://clinical.devices/schemas/linking/ClinicalPathway.schema.json"
}