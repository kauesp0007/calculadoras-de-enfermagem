{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "ProcedureProtocol",
  "description": "Protocolo de procedimento: passos, modos de falha e barreiras.",
  "required": [
    "id",
    "procedure",
    "steps"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "procedure": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "step",
          "action"
        ],
        "properties": {
          "step": {
            "type": "integer"
          },
          "action": {
            "type": "string"
          },
          "critical": {
            "type": "boolean"
          }
        }
      }
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failureModes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "safetyBarriers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "Human",
              "Technology",
              "Process"
            ]
          },
          "barrier": {
            "type": "string"
          }
        }
      }
    }
  },
  "$id": "https://clinical.devices/schemas/linking/ProcedureProtocol.schema.json"
}