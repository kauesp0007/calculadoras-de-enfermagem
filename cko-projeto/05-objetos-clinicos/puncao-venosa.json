    "steps": [
      {
        "order": 1,
        "action": "Higienizar as mãos e utilizar EPI",
        "notes": "Luvas de procedimento obrigatórias"
      },
      {
        "order": 2,
        "action": "Identificar o paciente e explicar o procedimento",
        "notes": "2 identificadores"
      },
      {
        "order": 3,
        "action": "Selecionar veia adequada",
        "notes": "Preferir veias distal para proximal; evitar articulações"
      },
      {
        "order": 4,
        "action": "Aplicar torniquete 10-15 cm acima do local",
        "notes": "Não ultrapassar 2 minutos"
      },
      {
        "order": 5,
        "action": "Higienizar o local com fricção por 30 segundos",
        "notes": "Clorexidina alcoólica preferida"
      },
      {
        "order": 6,
        "action": "Aguardar secagem completa",
        "notes": "Não soprar ou tocar"
      },
      {
        "order": 7,
        "action": "Estabilizar a veia e inserir o cateter com ângulo de 10-30°",
        "notes": "Observar retorno sanguíneo"
      },
      {
        "order": 8,
        "action": "Avançar o cateter e retirar a agulha",
        "notes": "Ativar mecanismo de segurança imediatamente"
      },
      {
        "order": 9,
        "action": "Conectar equipo ou tampa heparinizada",
        "notes": "Verificar permeabilidade"
      },
      {
        "order": 10,
        "action": "Fixar com curativo transparente",
        "notes": "Registrar data, hora e calibre"
      },
      {
        "order": 11,
        "action": "Descartar materiais perfurocortantes em coletor adequado",
        "notes": "Nunca reencapar"
      }
