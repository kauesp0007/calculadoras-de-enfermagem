  "domainPayload": {
    "normalValues": {
      "adult": {
        "systolic": "90-120 mmHg",
        "diastolic": "60-80 mmHg",
        "map": ">65 mmHg"
      },
      "elderly": {
        "systolic": "<150 mmHg (fragilidade)",
        "diastolic": ">60 mmHg"
      },
      "pediatric": {
        "systolic": "70 + (2 x idade em anos) mmHg",
        "diastolic": "2/3 da sistólica"
      }
    },
    "measurementTechnique": {
      "auscultatory": {
        "equipment": "Esfigmomanômetro aneroide/mercurial + estetoscópio",
        "position": "Paciente sentado ou decúbito dorsal, braço ao nível do coração",
        "cuff": "Manguito cobrindo 80% do braço",
        "procedure": [
          "Inflar 20-30 mmHg acima da desaparição do pulso",
          "Desinflar 2-3 mmHg/segundo",
          "1º som = PAS",
          "Desaparecimento = PAD (Korotkoff V)"
        ],
        "notes": "Evitar conversar durante a medição; aguardar 1-2 min entre medições"
      },
      "oscillometric": {
        "equipment": "Monitor multiparamétrico ou aparelho digital",
        "position": "Mesmo da auscultatória",
        "cuff": "Tamanho adequado ao perímetro braquial",
        "notes": [
          "Verificar calibração periódica",
          "Não confiar em arritmias",
          "Confirmar com método auscultatório se dúvida"
        ]
      },
      "invasive": {
        "equipment": "Cateter arterial + transdutor",
        "indication": "Pacientes em choque, uso de vasopressores, pós-operatório de grande porte",
        "complications": [
          "Isquemia distal",
          "Hematoma",
          "Infecção",
          "Embolia"
        ]
      }
    },
    "clinicalMeaning": {
      "systolic": "Reflete a contratilidade cardíaca e o volume sistólico",
      "diastolic": "Reflete a resistência vascular periférica e o tônus arterial",
      "map": "Pressão média de perfusão tecidual (MAP = PAD + (PAS-PAD)/3)"
    },
    "abnormalValues": {
      "hypertension": {
        "definition": "PAS ≥140 ou PAD ≥90 mmHg",
        "grades": [
