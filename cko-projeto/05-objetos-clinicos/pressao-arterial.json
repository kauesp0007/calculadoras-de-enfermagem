        "crisis": "PAS ≥180 e/ou PAD ≥120 com sinais de lesão de órgão-alvo"
      },
      "hypotension": {
        "definition": "PAS <90 ou PAD <60 mmHg",
        "causes": [
          "Hipovolemia",
