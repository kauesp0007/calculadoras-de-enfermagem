    },
    "decisionPoints": [
      {
        "id": "dp1",
        "condition": "MAP <65 mmHg após 30mL/kg",
        "action": "Iniciar noradrenalina",
        "alternative": "Vasopressina se refratária"
      },
      {
        "id": "dp2",
        "condition": "Lactato >4 mmol/L",
        "action": "Ressuscitação agressiva",
        "alternative": "Monitorização intensiva"
      },
      {
        "id": "dp3",
        "condition": "Cultura positiva para germe específico",
        "action": "De-escalar antibiótico",
        "alternative": "Manter amplo espectro se não identificado"
      }
    ],
    "exceptions": [
      {
        "scenario": "Gestante",
        "modification": "Evitar vancomicina se possível; preferir cefalosporinas seguras"
      },
      {
        "scenario": "Insuficiência renal",
        "modification": "Ajustar dose de antibióticos e evitar nefrotoxicidade"
      },
      {
        "scenario": "Alergia a beta-lactâmicos",
        "modification": "Substituir por aztreonam + vancomicina + metronidazol"
      }
    ],
    "checklist": [
      "Hemoculturas coletadas antes dos antibióticos",
      "Antibióticos administrados em até 1h",
      "30 mL/kg de cristaloides infundidos",
      "Lactato mensurado",
      "Cateter venoso central quando indicado",
      "Monitorização de diurese",
      "Controle glicêmico iniciado"
    ],
    "references": [
      "Surviving Sepsis Campaign 2021",
      "Ministério da Saúde - Protocolo de Sepse"
    ]
  }
