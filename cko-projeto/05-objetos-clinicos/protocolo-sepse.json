  "domainPayload": {
    "objective": "Reduzir mortalidade por sepse através da identificação precoce e intervenções no tempo adequado.",
    "indications": [
      "Sepse confirmada ou suspeita",
      "Choque séptico",
      "Disfunção orgânica por infecção"
    ],
    "contraindications": [
      "Contraindicação absoluta aos antibióticos de 1ª linha (alergia grave documentada)"
    ],
    "steps": [
      {
        "order": 1,
        "time": "0-10min",
        "action": "Reconhecer sepse (qSOFA ≥2 ou SIRS + suspeita de infecção)",
        "responsible": "Equipe de enfermagem/médica"
      },
      {
        "order": 2,
        "time": "0-10min",
        "action": "Coletar 2 pares de hemoculturas (aeróbio/anaeróbio)",
        "responsible": "Enfermagem"
      },
      {
        "order": 3,
        "time": "0-45min",
        "action": "Administrar antibióticos de amplo espectro",
        "responsible": "Enfermagem/Médico"
      },
      {
        "order": 4,
        "time": "0-60min",
        "action": "Iniciar ressuscitação volêmica: 30 mL/kg de cristaloides",
        "responsible": "Enfermagem"
      },
      {
        "order": 5,
        "time": "0-60min",
        "action": "Medir lactato sérico",
        "responsible": "Enfermagem/Laboratório"
      },
      {
        "order": 6,
        "time": "1-3h",
        "action": "Reavaliação hemodinâmica. Iniciar vasopressores se MAP <65 mmHg",
        "responsible": "Médico/UTI"
      },
      {
        "order": 7,
        "time": "3-6h",
        "action": "Repetir lactato. Objetivo: normalização",
        "responsible": "Laboratório"
      },
      {
        "order": 8,
        "time": "6-24h",
        "action": "Reavaliação diária de antibioticoterapia. De-escalar conforme cultura",
        "responsible": "Médico infectologista"
      }
    ],
    "flowchart": {
      "nodes": [
        "Suspeita de infecção",
        "qSOFA≥2 ou SIRS",
        "Hemoculturas",
        "Antibióticos",
        "Fluidos 30mL/kg",
        "Lactato",
        "Vasopressores",
        "Reavaliação"
      ],
      "edges": [
        {
          "from": "Suspeita de infecção",
