    "subcategory": "Antropometria",
    "description": "Calcula o Índice de Massa Corporal e classifica conforme a OMS.",
    "shortDescription": "IMC = peso / altura². Classificação OMS.",
    "tags": [
      "imc",
      "antropometria",
      "nutricao",
      "obesidade",
      "magreza"
    ],
    "language": "pt-BR"
  },
  "core": {
    "runtime": {
      "components": [
        "KnowledgeHeader",
        "InputForm",
        "CalculatorEngine",
        "ResultDisplay",
        "ClinicalInterpretation",
        "CalculationMemory",
        "Limitations",
        "FAQ",
        "EvidenceLevel",
        "KnowledgeGraph"
      ]
    },
    "knowledgeGraph": {
      "relatedObjects": [
        "escala-braden",
        "diabetes",
        "hipertensao",
        "calculadora-superficie-corporal"
      ]
