  },
  "domainPayload": {
    "inputs": [
      {
        "id": "peso",
        "label": "Peso (kg)",
        "type": "number",
        "min": 0.5,
        "max": 500,
        "step": 0.1,
        "required": true,
        "unit": "kg"
      },
      {
        "id": "altura",
        "label": "Altura (m)",
        "type": "number",
        "min": 0.3,
        "max": 3,
        "step": 0.01,
        "required": true,
        "unit": "m"
      }
    ],
    "formula": "peso / (altura * altura)",
    "validation": [
      {
        "condition": "peso > 0",
        "message": "Peso deve ser maior que zero"
      },
      {
        "condition": "altura > 0",
        "message": "Altura deve ser maior que zero"
      }
    ],
    "calculation": {
      "steps": [
        "Receber peso em kg",
        "Receber altura em metros",
        "Aplicar fórmula IMC = peso / altura²",
        "Arredondar para 1 casa decimal"
      ],
      "precision": 1,
      "unit": "kg/m²"
    },
    "interpretation": {
      "ranges": [
        {
          "min": 0,
          "max": 18.5,
          "label": "Magreza",
          "color": "#3b82f6",
