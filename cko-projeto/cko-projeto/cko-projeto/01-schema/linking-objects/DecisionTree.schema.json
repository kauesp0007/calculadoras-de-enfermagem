{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "DecisionTree",
  "description": "Árvore de decisão clínica executável.",
  "required": [
    "id",
    "rootNode",
    "nodes"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "rootNode": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "decision",
              "action",
              "terminal"
            ]
          },
          "condition": {
            "type": "object"
          },
          "yes": {
            "type": "string"
          },
          "no": {
            "type": "string"
          }
        }
      }
    }
  },
  "$id": "https://clinical.devices/schemas/linking/DecisionTree.schema.json"
}