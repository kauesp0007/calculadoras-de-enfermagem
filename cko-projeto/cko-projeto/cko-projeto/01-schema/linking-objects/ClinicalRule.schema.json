{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "ClinicalRule",
  "description": "Regra clínica executável: when→then, com severidade e evidência.",
  "required": [
    "id",
    "when",
    "then"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "when": {
      "type": "object",
      "properties": {
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "field",
              "operator",
              "value"
            ],
            "properties": {
              "field": {
                "type": "string"
              },
              "operator": {
                "type": "string",
                "enum": [
                  "equals",
                  "notEquals",
                  "in",
                  "notIn",
                  "greaterThan",
                  "lessThan"
                ]
              },
              "value": {}
            }
          }
        }
      }
    },
    "then": {
      "type": "object",
      "properties": {
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "target"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "recommend",
                  "avoid",
                  "block",
                  "alert",
                  "require"
                ]
              },
              "target": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "severity": {
      "type": "string",
      "enum": [
        "Baixa",
        "Moderada",
        "Alta",
        "Crítica"
      ]
    },
    "evidenceRef": {
      "type": "string"
    },
    "source": {
      "type": "string"
    }
  },
  "$id": "https://clinical.devices/schemas/linking/ClinicalRule.schema.json"
}