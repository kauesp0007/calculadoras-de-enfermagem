{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "AuditIndicatorRule",
  "description": "Indicador auditável com meta, benchmark e ciclo PDSA.",
  "required": [
    "id",
    "indicator"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "indicator": {
      "type": "string"
    },
    "formula": {
      "type": "string"
    },
    "target": {
      "type": "number"
    },
    "benchmark": {
      "type": "number"
    },
    "unit": {
      "type": "string"
    },
    "threshold": {
      "type": "object",
      "properties": {
        "warning": {
          "type": "number"
        },
        "critical": {
          "type": "number"
        }
      }
    },
    "qualityCycle": {
      "type": "object",
      "properties": {
        "measure": {
          "type": "string",
          "default": "PDSA"
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$id": "https://clinical.devices/schemas/linking/AuditIndicatorRule.schema.json"
}