{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "FHIRMapping",
  "description": "Mapeamento do objeto CKO para recurso FHIR + códigos.",
  "required": [
    "id",
    "sourceType",
    "fhirResource"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "sourceType": {
      "type": "string"
    },
    "fhirResource": {
      "type": "string"
    },
    "profile": {
      "type": "string",
      "format": "uri"
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "system": {
            "type": "string"
          }
        }
      }
    }
  },
  "$id": "https://clinical.devices/schemas/linking/FHIRMapping.schema.json"
}