{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "DrugDeviceMatrix",
  "description": "Matriz de compatibilidade medicamento↔dispositivo/doença (ligação que faltava).",
  "required": [
    "id",
    "entries"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "drug"
        ],
        "properties": {
          "drug": {
            "type": "string"
          },
          "disease": {
            "type": "string"
          },
          "preferredDevice": {
            "type": "string"
          },
          "avoidDevices": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "route": {
            "type": "string"
          },
          "risk": {
            "type": "string",
            "enum": [
              "Baixo",
              "Moderado",
              "Alto",
              "Crítico"
            ]
          },
          "reason": {
            "type": "string"
          },
          "evidenceRef": {
            "type": "string"
          }
        }
      }
    }
  },
  "$id": "https://clinical.devices/schemas/linking/DrugDeviceMatrix.schema.json"
}