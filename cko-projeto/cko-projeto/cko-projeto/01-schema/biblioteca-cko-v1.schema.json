{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clinical.devices/schemas/biblioteca-cko-v1.schema.json",
  "title": "CKO Biblioteca de Materiais/Dispositivos — v1.0",
  "description": "Envelope comum das bibliotecas de materiais e dispositivos (curativos, cateteres, agulhas, etc.). O miolo específico de cada categoria vive em exclusiveModules + characteristics.",
  "type": "object",
  "required": [
    "id",
    "name",
    "icon",
    "description",
    "category",
    "subcategory",
    "tags",
    "semantic",
    "risk",
    "clinicalKnowledge",
    "nursingIntelligence",
    "decisionIntelligence",
    "patientSafety",
    "education",
    "aiMetadata",
    "auditTrail",
    "localization"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "icon": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "category": {
      "type": "string",
      "enum": [
        "Materiais e Dispositivos",
        "Avaliação Clínica",
        "Produtos para Saúde"
      ]
    },
    "subcategory": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 3
    },
    "catalog": {
      "type": "object",
      "properties": {
        "manufacturers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "productCodes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "registration": {
          "type": "string"
        },
        "technicalDocs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "semantic": {
      "type": "object",
      "required": [
        "snomed",
        "deviceCategory",
        "clinicalDomain",
        "fhirMapping"
      ],
      "properties": {
        "snomed": {
          "type": "string"
        },
        "loinc": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deviceCategory": {
          "type": "string"
        },
        "clinicalDomain": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fhirMapping": {
          "type": "object",
          "required": [
            "resource",
            "codeSystem"
          ]
        }
      }
    },
    "regulatory": {
      "type": "object",
      "properties": {
        "anvisa": {
          "type": "string"
        },
        "fda": {
          "type": "string"
        },
        "eu": {
          "type": "string"
        },
        "iso": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "risk": {
      "type": "object",
      "required": [
        "level",
        "rationale"
      ],
      "properties": {
        "anvisaClass": {
          "type": "string"
        },
        "fdaClass": {
          "type": "string"
        },
        "level": {
          "type": "string",
          "enum": [
            "Baixo",
            "Moderado",
            "Alto",
            "Variável",
            ""
          ]
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "exclusiveModules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Nomes dos módulos específicos da categoria; cada um é uma chave em characteristics."
    },
    "characteristics": {
      "type": "object",
      "description": "Miolo específico da categoria, keyed pelos exclusiveModules."
    },
    "clinicalKnowledge": {
      "type": "object",
      "required": [
        "clinicalPurpose",
        "indications",
        "contraindications"
      ],
      "properties": {
        "clinicalPurpose": {
          "type": "object",
          "required": [
            "primary"
          ]
        },
        "indications": {
          "type": "array"
        },
        "contraindications": {
          "type": "array",
          "description": "CANÔNICO — não usar 'contraindicaciones'."
        },
        "clinicalRisks": {
          "type": "array"
        },
        "evidence": {
          "type": "object"
        }
      }
    },
    "nursingIntelligence": {
      "type": "object",
      "required": [
        "nursingProcess"
      ]
    },
    "decisionIntelligence": {
      "type": "object"
    },
    "comparisonEngine": {
      "type": "object"
    },
    "patientSafety": {
      "type": "object",
      "required": [
        "highRisk",
        "neverEvents",
        "alerts"
      ]
    },
    "sustainability": {
      "type": "object"
    },
    "education": {
      "type": "object",
      "required": [
        "learningPath",
        "resources"
      ]
    },
    "workflowIntegration": {
      "type": "object"
    },
    "aiMetadata": {
      "type": "object",
      "required": [
        "knowledgeType",
        "reasoningRules",
        "confidenceModel"
      ]
    },
    "commercialIntelligence": {
      "type": "object"
    },
    "auditTrail": {
      "type": "object",
      "required": [
        "principles"
      ]
    },
    "localization": {
      "type": "object",
      "required": [
        "language",
        "country",
        "translationStatus"
      ]
    }
  },
  "$comment": "Objetos de category 'Avaliação Clínica' (ex.: feridas) podem ter catalog vazio; 'Produtos para Saúde' (antissepticos) idem."
}