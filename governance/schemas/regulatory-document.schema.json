{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.calculadorasdeenfermagem.com.br/schemas/regulatory-document.schema.json",
  "title": "Documento regulatório local candidato a evidência",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_id", "source_path", "file_name", "sha256", "document_type", "source_authority", "review_status"],
  "properties": {
    "document_id": { "type": "string", "pattern": "^DOC-[A-F0-9]{12}$" },
    "source_path": { "type": "string", "pattern": "^docs/" },
    "file_name": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "document_type": { "type": "string", "enum": ["LEGISLATION", "REGULATION", "OPINION", "GUIDELINE", "SCIENTIFIC_ARTICLE", "OTHER"] },
    "source_authority": { "type": "string", "enum": ["OFFICIAL", "ACADEMIC", "SCIENTIFIC", "UNKNOWN"] },
    "official_source_url": { "type": ["string", "null"], "format": "uri" },
    "canonical_id": { "type": ["string", "null"] },
    "review_status": { "type": "string", "enum": ["PENDING_EDITORIAL_REVIEW", "APPROVED", "REJECTED", "SUPERSEDED"] },
    "reviewed_at": { "type": ["string", "null"], "format": "date" },
    "professional_review_ref": { "type": ["string", "null"] },
    "notes": { "type": "string" }
  }
}